<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>update-student</title>
</head>

<body>
    <form method="post" action="/ui/update/<%= result._id %>">
        <input type="text" name="name" placeholder="enter student name" value="<%= result.name %>" />
        <br /><br />
        <input type="text" name="email" placeholder="enter student email"  value="<%= result.email %>"/>
        <br /><br />
        <input type="text" name="age" placeholder="enter student age" value="<%= result.age %>" />
        <br /><br />
        <button>Update Student</button>
    </form>
</body>

</html>